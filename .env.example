# Placeholders only. Copy to .env and set passwords locally; never commit .env.
# PostgreSQL bootstrap administrator: NEVER use this identity in agent tools.
POSTGRES_DB=agentic_investigation
POSTGRES_USER=bootstrap_admin
POSTGRES_PASSWORD=
# Host for future containers; use localhost for clients running on the host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Migration creates this fixed NOLOGIN role. Privately provision login/password for the PostgreSQL adapter.
# Agent consumes these only with SQL_BACKEND=postgres; Compose/migrations do not consume them.
AGENT_DB_USER=investigation_reader
AGENT_DB_PASSWORD=

# Java is implemented; application services are not started by Compose yet
EXPERIENCE_SERVICE_PORT=8080
# Future Compose hostname; use http://localhost:8000 for host Java development.
AGENT_SERVICE_BASE_URL=http://agent-service:8000
AGENT_CONNECT_TIMEOUT=2s
AGENT_REQUEST_TIMEOUT=65s
AGENT_SERVICE_PORT=8000
# Next server forwards browser requests to Java; no CORS configuration needed.
EXPERIENCE_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_EXPERIENCE_API_BASE_URL=/api/experience

# Python defaults to explicit synthetic development mode; no paid calls.
AGENT_MODE=development
SQL_BACKEND=fixture
# For postgres mode, set POSTGRES_HOST=localhost when running Python on the host.
# PostgreSQL requires an explicit approved allowlist; fixture mode has a fixed synthetic allowlist.
# SQL and workflow policy
SQL_ALLOWED_TABLES=
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_DEFAULT_ROW_LIMIT=100
SQL_MAX_ROW_LIMIT=500
INVESTIGATION_MAX_ITERATIONS=5
INVESTIGATION_MAX_STEPS=40
INVESTIGATION_MAX_DURATION_SECONDS=60
INVESTIGATION_RETENTION_SECONDS=3600
INVESTIGATION_STORE_CAPACITY=100
INVESTIGATION_MAX_CONCURRENCY=4

# Used only in AGENT_MODE=production. Never expose keys through NEXT_PUBLIC_ variables.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LOG_LEVEL=INFO
